#!/usr/bin/env bash
# router on|off|status|stats [args]|install-repo <path> [--force]
#
#   on / off      toggle the model router; the hook reads the flag on every
#                 prompt, so no restart is needed
#   status        on/off, and whether the plugin is installed
#   stats         delegation and cost report from local transcripts
#   install-repo  install the router into a repo's .claude/ for cloud sessions
#                 (--force replaces agent files you edited, keeping a .bak)
set -euo pipefail

CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
DATA_DIR="$CONFIG_DIR/model-router"

usage() { echo "usage: router on|off|status|stats [--since D] [--json]|install-repo <path> [--force]"; exit 1; }
[ $# -ge 1 ] || usage

case "$1" in
  on|off|status) [ $# -eq 1 ] || usage;;
esac

case "$1" in
  on)
    rm -f "$DATA_DIR/OFF"
    echo "router: on  (applies from the next prompt, no restart needed)"
    ;;
  off)
    mkdir -p "$DATA_DIR"
    : > "$DATA_DIR/OFF"
    echo "router: off (applies from the next prompt, no restart needed)"
    ;;
  status)
    if [ -e "$DATA_DIR/OFF" ]; then echo "off"; else echo "on"; fi
    if grep -qF '"model-router@claude-model-router"' "$CONFIG_DIR/plugins/installed_plugins.json" 2>/dev/null; then
      echo "plugin: installed"
    else
      echo "plugin: not installed"
    fi
    ;;
  stats)
    shift
    exec python3 "$DATA_DIR/router_stats.py" "$@"
    ;;
  install-repo)
    shift
    [ $# -ge 1 ] || usage
    exec python3 "$DATA_DIR/router_kit.py" install-repo "$@"
    ;;
  *) usage;;
esac
